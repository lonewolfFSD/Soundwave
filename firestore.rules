rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin Helper ──
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'sKYA2iNBmOeUlb2uxyUkxZaI14G2';
    }

    // ── Users collection ──
    match /users/{userId} {
      // Users can manage themselves, but Admin can see and manage EVERYONE
      allow read, write: if isAdmin(); 
      allow read, create, update: if request.auth != null && request.auth.uid == userId;

      match /uploads/{songId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null 
                      && request.auth.uid == userId
                      && request.resource.data.title is string
                      && request.resource.data.artist is string
                      && request.resource.data.coverArtBase64 is string;
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // ── Playlists Collection ──
    match /playlists/{playlistId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;

      // ── Songs Subcollection ──
      match /songs/{songId} {
        // Ensures the document actually exists before checking userId
        function isPlaylistOwner() {
          let pDoc = get(/databases/$(database)/documents/playlists/$(playlistId));
          return pDoc != null && pDoc.data.userId == request.auth.uid;
        }

        allow read, update, delete: if request.auth != null && isPlaylistOwner();
        
        allow create: if request.auth != null 
                      && isPlaylistOwner()
                      && request.resource.data.title is string
                      && request.resource.data.coverArtBase64 is string;
      }
    }

    // ── 🎵 Listen Together (Jam Rooms) ──
    match /jamRooms/{roomId} {
      // Anyone can discover public rooms in lobby or lookup room code
      allow read: if true;

      // Logged-in users can create rooms
      allow create: if request.auth != null;

      // Logged-in participants can sync playback, seek, chat, react, & add to queue
      allow update: if request.auth != null;

      // Room host or admin can delete room
      allow delete: if request.auth != null && (
        resource.data.hostUid == request.auth.uid ||
        isAdmin()
      );
    }

    // ── 🤖 Soundie AI Conversations & Memories ──
    match /soundie_conversations/{docId} {
      allow read, write: if request.auth != null;
    }
    match /soundie_memories/{docId} {
      allow read, write: if request.auth != null;
    }

  }
}
