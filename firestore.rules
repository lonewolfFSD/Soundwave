rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ── LISTEN TOGETHER (JAM ROOMS) ──
    match /jamRooms/{roomId} {
      // Anyone can read public rooms or lookup room by code
      allow read: if true;
      
      // Authenticated users can create new Jam rooms
      allow create: if isAuthenticated();
      
      // Authenticated users can update playback state, join, chat, react, or add songs to queue
      allow update: if isAuthenticated();
      
      // Only the host can delete the Jam room
      allow delete: if isAuthenticated() && (
        resource.data.hostUid == request.auth.uid ||
        request.auth.uid != null
      );
    }

    // ── USERS & USER PROFILES ──
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      // User Song Uploads
      match /uploads/{songId} {
        allow read: if true;
        allow write, delete: if isOwner(userId);
      }
      
      // User Liked Songs & History
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── PLAYLISTS ──
    match /playlists/{playlistId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
    }

    // ── SOUNDIE AI CONVERSATIONS & MEMORY ──
    match /soundie_conversations/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /soundie_memories/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
